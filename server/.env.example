# RedSight copilot backend — copy to server/.env and fill in ONE provider key.
# server/.env is git-ignored; keys never reach the client bundle.
# A GROQ key also unlocks cloud STT (whisper-large-v3-turbo).

# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# STT_MODEL=whisper-large-v3-turbo
# GEMINI_WEB_SEARCH=true
# PORT=8788
# HOST=127.0.0.1
# FastAPI native-terrain routing bridge (engine/api.py; default shown)
# ROUTING_API_URL=http://127.0.0.1:8790
# FastAPI native-terrain routing bridge (engine/api.py; default shown)
# ROUTING_API_URL=http://127.0.0.1:8790
# Comma-separated extra origins allowed to call /api (e.g. your deployed URL)
# ALLOWED_ORIGINS=https://example.github.io
